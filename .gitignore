# Firebase secrets — keep service-account JSON OUT of the repo (full project
# access). google-services.json itself is shipped inside every APK we
# distribute, so committing it here doesn't leak anything new — and EAS Build
# needs it from git to embed the FCM Sender ID into the build.
!apps/mobile/google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json

# Google Play service account (EAS Android submit) — full Play Console access, NEVER commit
play-service-account.json
eas-play-*.json
*service-account*.json

coverage/
.nyc_output/

.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.claude/

*.tsbuildinfo
.eslintcache

prisma/*.db
prisma/*.db-journal
prisma/seed.js
prisma/seed.d.ts
prisma/seed.js.map
prisma/seed.d.ts.map

uploads/
minio-data/
postgres-data/
redis-data/

keys/
*.pem

# Optional bearer token Prometheus sends when scraping the API's /metrics
# (see docs/OBSERVABILITE.md). Same value as METRICS_TOKEN in .env.prod.
monitoring/prometheus/metrics_token

# Playwright artifacts
e2e/playwright-report/
e2e/test-results/

# Smoke test artifacts
scripts/*.png

# Generated SAST artifact (regenerated by gwani-pentest each audit)
SECURITY_REPORT.md

# Configuration Alertmanager generee au deploiement depuis .env.prod :
# elle contient les identifiants SMTP, elle ne doit jamais etre commitee.
monitoring/alertmanager/alertmanager.generated.yml
monitoring/alertmanager/smtp_password

# Journaux de l atelier d animation (local, jamais versionne)
logs/

# Sources Midjourney des avatars d animation : 139 Mo de PNG, hors depot.
# Le mapping, lui, est versionne (docs/midjourney_session/mapping.json).
docs/midjourney_session/*.png

# Modèle GGUF du rédacteur de secours (2 Go) — téléchargé sur le VPS, jamais versionné.
models/
