// ── E-TAUX : taux du jour + prix crowdsourcés ─────────────────────────────
// FX snapshot published by the ECB (eurofxref-daily.xml — free, no key, no
// quota). One row per published TARGET business day. EUR/XOF is NOT stored:
// it is a regulatory constant (1 EUR = 655.957 XOF, UEMOA peg since 1999),
// coded in the service layer. XOF/USD & XOF/CAD are derived at read time from
// the latest snapshot + peg — never stored, never user-supplied.
model FxRateSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  asOf      DateTime @unique @map("as_of") @db.Date // ECB publication day
  eurUsd    Decimal  @map("eur_usd") @db.Decimal(10, 6)
