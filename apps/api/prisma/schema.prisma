  @@index([asOf(sort: Desc)])
  @@map("fx_rate_snapshots")
}

enum CommunityPriceType {
  billet_avion
  transfert_argent
  colis_kg
}

enum CommunityPriceStatus {
  active
  removed // takedown modération (Report → content_removed)
}

// A community-reported price (plane ticket / money transfer / parcel per kg).
// No official free source exists for these, so they are crowdsourced + voted
// for trust. No media field → no S3 dependency.
model CommunityPrice {
  id            String               @id @default(uuid()) @db.Uuid
  submitterId   String               @map("submitter_id") @db.Uuid
  submitter     User                 @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  type          CommunityPriceType
  originCity    String?              @map("origin_city") @db.VarChar(100)
  originCountry String?              @map("origin_country") @db.Char(2)
  destCity      String?              @map("dest_city") @db.VarChar(100)
  destCountry   String?              @map("dest_country") @db.Char(2)
  provider      String?              @db.VarChar(100)
  amount        Decimal              @db.Decimal(12, 2)
  currency      String               @db.Char(3)
  note          String?              @db.VarChar(280)
  // Denormalised sum of votes, kept coherent with the vote rows in the same
  // transaction (mirror of Comment.likeCount).
  trustScore    Int                  @default(0) @map("trust_score")
  status        CommunityPriceStatus @default(active)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  votes CommunityPriceVote[]

  @@index([type, status, createdAt(sort: Desc)])
  @@index([type, originCountry, destCountry, status])
  @@index([submitterId])
  @@map("community_prices")
}

// Trust vote on a community price. Composite PK (userId, priceId) makes the
// vote unique per user (anti double-vote) — mirror of CommentLike.
model CommunityPriceVote {
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceId   String         @map("price_id") @db.Uuid
  price     CommunityPrice @relation(fields: [priceId], references: [id], onDelete: Cascade)
  value     Int // 1 = fiable, -1 = pas fiable
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, priceId])
  @@index([priceId])
  @@map("community_price_votes")
}

model Association {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String              @db.VarChar(200)
  // Anti-squat (A6): immutable, generated once at create() from `name`
  // (slugify()), never edited afterwards even if the display name changes
  // later. `normalizedName` is the SAME computed value, kept as a second
  // column/constraint on purpose — it is the "no two associations share a
  // name" guarantee, `slug` is the "stable URL" guarantee. They happen to be
  // equal today; keeping them as two separate unique keys means a future
  // change to slug formatting (e.g. allowing edits) doesn't silently reopen
  // the name-squat hole.
  slug                  String              @unique @db.VarChar(220)
  normalizedName        String              @unique @map("normalized_name") @db.VarChar(200)
  // B5 — octets occupés par les médias déposés dans l'espace de CETTE
  // association (`associations/{id}/`, ADR-002). Compté à l'attache, rendu à
  // la suppression de la publication (qui purge alors les objets). Un Int
  // suffit et le restera : la réclamation atomique interdit de dépasser le
  // quota, très en deçà des 2,1 Go que ce type porte.
  mediaBytes            Int                 @default(0) @map("media_bytes")
  description           String?             @db.Text
  logoUrl               String?             @map("logo_url") @db.VarChar(500)
  coverUrl              String?             @map("cover_url") @db.VarChar(500)
  category              AssociationCategory
  countryCode           String?             @map("country_code") @db.Char(2)
  city                  String?             @db.VarChar(100)
  website               String?             @db.VarChar(300)
  contactEmail          String?             @map("contact_email") @db.VarChar(255)
  isVerified            Boolean             @default(false) @map("is_verified")
  // A5 — traceability behind the badge: WHO granted/revoked it and WHEN, plus
  // an optional internal note. `verifiedById`/`verificationNote` are never
  // exposed on the public read paths (association.service ASSOCIATION_PUBLIC_SELECT
  // deliberately omits them) — only `verifiedAt` is public ("Vérifiée le …").
  verifiedAt            DateTime?           @map("verified_at") @db.Timestamptz
  verifiedById          String?             @map("verified_by") @db.Uuid
  verifiedBy            User?               @relation("AssociationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNote      String?             @map("verification_note") @db.Text
  requiresApproval      Boolean             @default(false) @map("requires_approval")
  // A1 (course-corrected) — default `public`: the nominative member list is
  // open to any authenticated user unless THIS association's admin/owner
  // opts into `members_only`. See the enum doc comment for why the default
  // is the open one.
  membersVisibility     AssociationMembersVisibility @default(public) @map("members_visibility")
  memberCount           Int                 @default(0) @map("member_count")
  createdById           String?             @map("created_by") @db.Uuid
  createdBy             User?               @relation("AssociationCreator", fields: [createdById], references: [id])
  // A3 — ownership transfer is opt-in on the receiving end: `requestOwnershipTransfer`
  // sets these two, `acceptOwnershipTransfer`/`declineOwnershipTransfer` clear
  // them. Never more than one pending transfer at a time.
  pendingOwnerId        String?             @map("pending_owner_id") @db.Uuid
  pendingOwner          User?               @relation("AssociationPendingOwner", fields: [pendingOwnerId], references: [id], onDelete: SetNull)
  pendingOwnerInvitedAt DateTime?           @map("pending_owner_invited_at") @db.Timestamptz
  // A2 — soft delete only: an association that lost its last member is dissolved
  // (excluded from every list/search/getById) but the row (and its audit trail)
  // is kept, unlike the hard `remove()` an admin can still trigger explicitly.
  deletedAt             DateTime?           @map("deleted_at") @db.Timestamptz
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  members    AssociationMember[]
  events     AssociationEvent[]
  officers   AssociationOfficer[]
  roleAudits AssociationRoleAudit[]

  @@index([category, countryCode])
  @@map("associations")
}

model AssociationMember {
  associationId String           @map("association_id") @db.Uuid
  association   Association      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  userId        String           @map("user_id") @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          AssociationRole  @default(member)
  status        MembershipStatus @default(approved)
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz

  @@id([associationId, userId])
  @@index([userId])
  @@map("association_members")
}

model AssociationEvent {
  id            String      @id @default(uuid()) @db.Uuid
  associationId String      @map("association_id") @db.Uuid
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  title         String      @db.VarChar(200)
  description   String?     @db.Text
  eventDate     DateTime    @map("event_date") @db.Timestamptz
  location      String?     @db.VarChar(200)
  coverUrl      String?     @map("cover_url") @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([associationId, eventDate])
  @@map("association_events")
}

// A3 — every role change (admin promotion/demotion, ownership transfer accept)
// leaves a row here: who did it, to whom, before → after, when. Append-only,
// never updated. Cascades with the association (its trail is moot once the
// association itself is gone) but NOT with the users involved individually —
// see the two relations below, both `onDelete: Cascade` too, matching the
// project's "RGPD delete is total, no tombstone" stance (profile.service.ts
// deleteAccount) rather than leaving a dangling/anonymized row.
model AssociationRoleAudit {
  id            String          @id @default(uuid()) @db.Uuid
  associationId String          @map("association_id") @db.Uuid
  association   Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  // SetNull, NOT Cascade: this trail belongs to the ASSOCIATION, not to the
  // people in it. Cascading on the actor made the A2 reassignment audit
  // self-erasing — reassignOwnershipBeforeDeletion writes the row with
  // actorId = the departing user, and the very next statement in the SAME
  // transaction (`user.delete`) wiped it again, so the one role change nobody
  // consciously decided was the one change with no trace at all.
  actorId       String?         @map("actor_id") @db.Uuid
  actor         User?           @relation("AssociationRoleAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId  String?         @map("target_user_id") @db.Uuid
  targetUser    User?           @relation("AssociationRoleAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  fromRole      AssociationRole @map("from_role")
  toRole        AssociationRole @map("to_role")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([associationId, createdAt])
  @@map("association_role_audits")
}

enum AssociationOfficerTitle {
  president
  vice_president
  secretary
  treasurer
  spokesperson
  other
}

// A1 (course-corrected) — the nominative roster (listMembers) is public to
// every authenticated NigerConnect user by default: you join an association
// to MEET compatriots, so seeing who's already there has to work BEFORE you
// join. `members_only` is the opt-out an association's own admin/owner can
// flip (updateAssociationSchema) — e.g. a `religieux` or political
// association where naming members can expose family still in-country. The
// choice belongs to the association, not to the platform, which is why the
// default is the open one, not the closed one.
enum AssociationMembersVisibility {
  public
  members_only
}

// A4 — the executive board. Deliberately separate from AssociationRole (the
// technical admin/moderator/member axis that governs permissions): a
// treasurer is a title, not a grant of admin rights. `acceptedAt` is the
// consent gate — an admin can propose a seat (row created, acceptedAt null)
// but nobody is publicly listed as an officer until they accept it
// themselves. One seat per (association, user) at a time — see the unique
// index; changing someone's title means removing and re-designating.
model AssociationOfficer {
  id            String                  @id @default(uuid()) @db.Uuid
  associationId String                  @map("association_id") @db.Uuid
  association   Association             @relation(fields: [associationId], references: [id], onDelete: Cascade)
  userId        String                  @map("user_id") @db.Uuid
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         AssociationOfficerTitle
  // Required (enforced in the Zod DTO, not the DB) when title = 'other'.
  customTitle   String?                 @map("custom_title") @db.VarChar(100)
  sortOrder     Int                     @default(0) @map("sort_order")
  acceptedAt    DateTime?               @map("accepted_at") @db.Timestamptz
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz

  @@unique([associationId, userId])
  @@index([associationId, sortOrder])
  @@map("association_officers")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String            @map("sender_id") @db.Uuid
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?           @db.Text
  messageType    MessageType       @default(text) @map("message_type")
  mediaUrl       String?           @map("media_url") @db.VarChar(500)
  replyToId      String?           @map("reply_to_id") @db.Uuid
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]         @relation("MessageReplies")
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz
  editedAt       DateTime?         @map("edited_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  reactions      MessageReaction[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

/// One emoji reaction per user per message (Messenger-style). Re-reacting with
/// the same emoji removes it; a different emoji switches it.
model MessageReaction {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, messageId])
  @@index([messageId])
  @@map("message_reactions")
}

model IdentityDocument {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation("UserIdentityDocuments", fields: [userId], references: [id], onDelete: Cascade)
  // 'passport' | 'id_card' | 'driver_license' | 'residence_permit' — or 'manual'
  // for an admin-driven verification with no uploaded document (fileUrl stays null).
  documentType    String         @map("document_type") @db.VarChar(30)
  // Nullable: a manual admin verification has no uploaded piece. User-submitted
  // documents always carry the private-bucket pointer.
  fileUrl         String?        @map("file_url") @db.VarChar(500)
  // Captured/validated by the admin at manual review. Used ONLY for the 18+ gate
  // (proximity feature) — private, never serialised to another user.
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  status          DocumentStatus @default(pending)
  reviewedById    String?        @map("reviewed_by") @db.Uuid
  reviewedBy      User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz
  rejectionReason String?        @map("rejection_reason") @db.Text
  // Admin justification recorded on a manual approve/revoke. Kept separate from
  // rejectionReason (the user-facing rejection motive) for audit clarity.
  reason          String?        @map("reason") @db.Text
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@map("identity_documents")
}

/**
 * Archivage intermédiaire (RGPD) d'une pièce d'identité.
 *
 * Le document actif vit 30 jours dans le bucket privé ; passé ce délai il n'est
 * plus détruit mais SCELLÉ dans le coffre (bucket `S3_VAULT_BUCKET`, object-lock
 * GOVERNANCE, chiffré par IdentityVaultService avec une clé publique dont la
 * privée reste hors-ligne). Finalité : constatation / exercice / défense d'un
 * droit en justice, et re-confirmation d'identité sur réquisition.
 *
 * Cette table N'A PAS de relation Prisma vers User : elle doit SURVIVRE à la
 * suppression du compte (le cascade la viderait). `userId` est donc un uuid nu.
 * Aucune donnée personnelle en clair ici — l'identité du titulaire est dans
 * l'enveloppe chiffrée. `contentSha256` sert à prouver qu'un document produit
 * plus tard est bien celui déposé, SANS ouvrir le coffre.
 */
model IdentityArchive {
  id            String   @id @default(uuid()) @db.Uuid
  // Uuid nu, volontairement sans FK (voir ci-dessus).
  userId        String   @map("user_id") @db.Uuid
  // Statut de la pièce au moment du scellement : 'approved' | 'rejected'.
  outcome       String   @db.VarChar(20)
  documentType  String   @map("document_type") @db.VarChar(30)
  // Clé de l'objet chiffré dans le coffre : `vault/<userId>/<archiveId>.enc`.
  vaultKey      String   @unique @map("vault_key") @db.VarChar(500)
  // sha256 hex du document ORIGINAL (avant chiffrement).
  contentSha256 String   @map("content_sha256") @db.Char(64)
  sizeBytes     Int      @map("size_bytes")
  archivedAt    DateTime @default(now()) @map("archived_at") @db.Timestamptz
  // Date d'effacement définitif. Validée : 5 ans après la suppression du compte
  // (donc repoussée le jour où le compte part) ; rejetée : 1 an après scellement.
  purgeAt       DateTime @map("purge_at") @db.Timestamptz
  // Verrou WORM effectivement posé sur l'objet. Une purge ne peut pas passer
  // avant cette date, même si purgeAt est plus proche.
  retainUntil   DateTime @map("retain_until") @db.Timestamptz
  // Renseigné quand le compte est supprimé — c'est ce qui déclenche le compteur
  // des 5 ans pour une pièce validée.
  accountDeletedAt DateTime? @map("account_deleted_at") @db.Timestamptz
  purgedAt      DateTime? @map("purged_at") @db.Timestamptz

  accesses IdentityArchiveAccess[]

  @@index([userId])
  @@index([purgeAt])
  @@map("identity_archives")
}

/**
 * Journal d'ouverture du coffre. Append-only : aucune route ne le modifie ni ne
 * le supprime, seul le CLI break-glass (`scripts/vault-open.ts`) y écrit. Sert
 * de preuve d'audit — qui a ouvert quelle pièce, quand, et sur quel motif.
 */
model IdentityArchiveAccess {
  id         String          @id @default(uuid()) @db.Uuid
  archiveId  String          @map("archive_id") @db.Uuid
  archive    IdentityArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  // Opérateur humain — email/identifiant saisi au CLI, pas un FK (l'ouverture
  // peut survenir des années après le départ de l'admin concerné).
  operator   String          @db.VarChar(255)
  // Motif obligatoire : réquisition judiciaire, litige, contrôle interne…
  reason     String          @db.Text
  accessedAt DateTime        @default(now()) @map("accessed_at") @db.Timestamptz

  @@index([archiveId])
  @@map("identity_archive_accesses")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceName String?   @map("device_name") @db.VarChar(100)
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.VarChar(500)
  platform  Platform
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Unicité sur le TOKEN seul, pas sur (userId, token) : un téléphone
  // n'appartient qu'à un compte à la fois. Avec le couple, une ligne d'un
  // compte quitté survivait à côté de celle du compte suivant, et le fan-out
  // lisant par userId poussait les messages privés de l'ancien compte sur
  // l'appareil du nouveau — aperçu du DM affiché sur l'écran verrouillé.
  @@unique([token])
  @@index([userId])
  @@map("push_tokens")
}

// Audit trail of privileged "admin full visibility" support accesses — written
// when an admin browses the god-mode map or opens a profile that the override
// (not normal permissions) made visible. adminId stored as a bare uuid (no FK)
// so the log survives the account's deletion.
model AdminAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String   @db.VarChar(50) // 'map_full_visibility' | 'profile_view_override'
  targetId  String?  @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([action, createdAt])
  @@map("admin_access_logs")
}

// Audit trail of sensitive admin USER-MANAGEMENT actions (status change / sanction,
// force-logout, MFA reset). Distinct from AdminAccessLog (which tracks the map/profile
// "full visibility" override). actorId + targetUserId are bare uuids (no FK) so the
// log survives either account's deletion. meta carries the action payload (motive,
// expiry, revoked count, …).
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(50)
  targetUserId String?  @map("target_user_id") @db.Uuid
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([targetUserId, createdAt])
  @@map("admin_audit_logs")
}

// Single-use TOTP recovery codes. Stored hashed (sha256); the plaintext is
// shown to the user exactly once at MFA enrollment. usedAt marks consumption.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// ── Pages (Feature: créer une page) ──────────────────────────────
// Generic user-created entity: communities, causes, businesses, official
// pages, groups. Distinct from Association (which keeps its own membership
// model). A Page has followers, admins, polls, and can receive reviews.
model Page {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  kind          PageKind @default(community)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  coverUrl      String?  @map("cover_url") @db.VarChar(500)
  countryCode   String?  @map("country_code") @db.Char(2)
  city          String?  @db.VarChar(100)
  website       String?  @db.VarChar(300)
  contactEmail  String?  @map("contact_email") @db.VarChar(255)
  isVerified    Boolean  @default(false) @map("is_verified")
  followerCount Int      @default(0) @map("follower_count")
  ratingAvg     Float    @default(0) @map("rating_avg")
  ratingCount   Int      @default(0) @map("rating_count")
  createdById   String?  @map("created_by") @db.Uuid
  createdBy     User?    @relation("PageCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  followers PageFollower[]
  admins    PageAdmin[]
  polls     Poll[]
  reviews   Review[]       @relation("ReviewTargetPage")

  @@index([kind, countryCode])
  @@index([createdById])
  @@map("pages")
}

model PageFollower {
  pageId    String   @map("page_id") @db.Uuid
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([pageId, userId])
  @@index([userId])
  @@map("page_followers")
}

model PageAdmin {
  pageId    String   @map("page_id") @db.Uuid
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PageRole @default(editor)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([pageId, userId])
  @@index([userId])
  @@map("page_admins")
}

// ── Polls / Sondages ─────────────────────────────────────────────
// A poll may belong to a page (pageId) or be standalone (pageId null).
model Poll {
  id          String    @id @default(uuid()) @db.Uuid
  pageId      String?   @map("page_id") @db.Uuid
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorId    String    @map("author_id") @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question    String    @db.VarChar(300)
  multiChoice Boolean   @default(false) @map("multi_choice")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  voteCount   Int       @default(0) @map("vote_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  options PollOption[]
  votes   PollVote[]

  @@index([pageId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid()) @db.Uuid
  pollId    String @map("poll_id") @db.Uuid
  poll      Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String @db.VarChar(200)
  voteCount Int    @default(0) @map("vote_count")
  sortOrder Int    @default(0) @map("sort_order")

  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  pollId    String     @map("poll_id") @db.Uuid
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String     @map("option_id") @db.Uuid
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  // One row per (poll, user, option): single-choice polls keep one row,
  // multi-choice polls allow several. Service enforces the single-choice rule.
  @@id([pollId, userId, optionId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_votes")
}

// ── Reviews / Avis ───────────────────────────────────────────────
// A review targets EITHER a user profile OR a page (exactly one of the two
// target FKs is set). Aggregates are denormalised onto User/Page.
model Review {
  id           String           @id @default(uuid()) @db.Uuid
  authorId     String           @map("author_id") @db.Uuid
  author       User             @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetType   ReviewTargetType @map("target_type")
  targetUserId String?          @map("target_user_id") @db.Uuid
  targetUser   User?            @relation("ReviewTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetPageId String?          @map("target_page_id") @db.Uuid
  targetPage   Page?            @relation("ReviewTargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // One review per author per target. NULLs are distinct in Postgres, so the
  // two partial uniques don't collide across target types.
  @@unique([authorId, targetUserId])
  @@unique([authorId, targetPageId])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([targetPageId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ── Newsletter ───────────────────────────────────────────────────
// Pre-launch waitlist + ongoing newsletter. Single opt-in: an email is stored
// directly when collected via the landing "M'avertir du lancement" form (no
// confirmation email). Every campaign carries a per-subscriber unsubscribe
// token surfaced through the List-Unsubscribe header (RGPD / CAN-SPAM).
enum NewsletterStatus {
  subscribed
  unsubscribed
}

enum CampaignStatus {
  draft
  sending
  sent
  failed
}

model NewsletterSubscriber {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(255)
  status           NewsletterStatus @default(subscribed)
  // Where the address came from: 'landing', 'admin', … (free-form, for stats).
  source           String?          @db.VarChar(50)
  locale           String?          @db.VarChar(10)
  // Opaque random token (hex) used for one-click unsubscribe links.
  unsubscribeToken String           @unique @map("unsubscribe_token") @db.VarChar(64)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  unsubscribedAt   DateTime?        @map("unsubscribed_at") @db.Timestamptz

  @@index([status])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id              String         @id @default(uuid()) @db.Uuid
  subject         String         @db.VarChar(200)
  // Inner HTML body (wrapped in the branded layout at send time) + plain-text part.
  bodyHtml        String         @map("body_html") @db.Text
  bodyText        String         @map("body_text") @db.Text
  // 'subscribers' = the standalone landing email list (default, legacy behaviour);
  // 'app_users'   = registered app users — delivered as in-app notification + push
  //                 + branded email, gated by User.newsletterOptIn unless critical.
  audience        String         @default("subscribers") @db.VarChar(20)
  // Critical service message: reaches ALL active users regardless of opt-in.
  critical        Boolean        @default(false)
  // Segment filters for the 'segment' audience (registered accounts):
  // { countryCode?, city?, verifiedOnly?, ambassadorOnly?, optInOnly?, activeSince? }.
  segment         Json?
  // Individual add/remove lists applied ON TOP of the resolved audience. Emails
  // are lower-cased; the dispatcher dedupes by email so no one is mailed twice.
  includeEmails   String[]       @default([]) @map("include_emails")
  excludeEmails   String[]       @default([]) @map("exclude_emails")
  // File attachments already uploaded to our own bucket: [{ url, filename, contentType }].
  attachments     Json?
  status          CampaignStatus @default(draft)
  totalRecipients Int            @default(0) @map("total_recipients")
  sentCount       Int            @default(0) @map("sent_count")
  failedCount     Int            @default(0) @map("failed_count")
  createdById     String?        @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz

  @@index([status])
  @@map("newsletter_campaigns")
}

// ── Parrainage — Invitation ───────────────────────────────────────
model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  // Code haute entropie partagé par le parrain. base62, 10+ chars (~59 bits).
  code         String           @unique @db.VarChar(16)
  // null = invitation racine générée par l'admin (bootstrap / seeding waitlist).
  inviterId    String?          @map("inviter_id") @db.Uuid
  inviter      User?            @relation("UserInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  // single_use (défaut) = email/code une acceptation ; reusable = lien de masse.
  kind         InvitationKind   @default(single_use)
  status       InvitationStatus @default(pending)
  // Comptes inscrits via cette invitation (surtout utile pour les liens reusable).
  signups      User[]           @relation("InvitationSignups")
  // Compte créé en consommant ce code. SetNull si ce compte est supprimé,
  // pour garder l'historique de l'invitation.
  acceptedById String?          @map("accepted_by_id") @db.Uuid
  acceptedBy   User?            @relation("UserInviteAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  // Data-minimization: email du destinataire ciblé par une invitation email.
  // Normalisé (lowercase+trim) avant stockage. PURGÉ (→ null) dès que
  // l'invitation quitte 'pending' (accept, revoke, expiry). On ne conserve
  // jamais l'email d'un tiers au-delà de la durée de vie de l'invitation.
  targetEmail  String?          @map("target_email") @db.VarChar(254)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([inviterId, status])
  @@index([inviterId, kind])
  @@index([status, expiresAt])
  @@index([status, targetEmail])
  @@map("invitations")
}

// ── Contact / partenariat ────────────────────────────────────────
// Messages envoyés depuis l'app (« Nous contacter »). Ils atterrissent dans la
// console admin ; un mail de notification part en parallèle vers l'adresse de
// contact pour ne pas dépendre d'une consultation régulière de la console.
model ContactMessage {
  id          String        @id @default(uuid()) @db.Uuid
  // null = message envoyé sans compte (formulaire public web plus tard).
  // SetNull plutôt que Cascade : la suppression d'un compte ne doit pas effacer
  // une discussion de partenariat en cours.
  userId      String?       @map("user_id") @db.Uuid
  user        User?         @relation("UserContactMessages", fields: [userId], references: [id], onDelete: SetNull)
  topic       ContactTopic  @default(info)
  // Email de réponse : celui du compte par défaut, modifiable dans le formulaire.
  email       String        @db.VarChar(254)
  // Optionnel — l'expéditeur peut préférer être rappelé.
  phone       String?       @db.VarChar(32)
  subject     String        @db.VarChar(140)
  message     String        @db.VarChar(4000)
  status      ContactStatus @default(new)
  // Trace de traitement : qui a changé le statut, et quand.
  handledById String?       @map("handled_by_id") @db.Uuid
  handledAt   DateTime?     @map("handled_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Liste admin : filtre par statut, tri antéchronologique.
  @@index([status, createdAt])
  @@index([userId])
  @@map("contact_messages")
}

// ── Compte officiel : diffusions ─────────────────────────────────

enum OfficialBroadcastKind {
  // Notification simple (cloche + push), sans conversation.
  notification
  // Message direct : une conversation officiel ↔ membre, un message dedans.
  message
}

enum OfficialBroadcastStatus {
  sending
  sent
  failed
}

// Journal des diffusions du compte officiel. Une notification ou un message
// « à tout le monde » part en tâche de fond (comme une campagne newsletter) :
// sans cette ligne, la console n'aurait ni accusé de réception, ni compteur, ni
// historique de ce qui a déjà été dit à la communauté.
model OfficialBroadcast {
  id       String                  @id @default(uuid()) @db.Uuid
  kind     OfficialBroadcastKind
  status   OfficialBroadcastStatus @default(sending)
  title    String                  @db.VarChar(140)
  body     String                  @db.VarChar(4000)
  // Cible : 'all' (tous les comptes actifs) ou 'user' (envoi à une personne).
  audience String                  @default("all") @db.VarChar(20)
  // Destinataire unique quand audience = 'user'. SetNull : la suppression du
  // compte ne doit pas effacer la trace de ce que la plateforme a envoyé.
  targetId String?                 @map("target_id") @db.Uuid
  // Chemin d'ouverture dans l'app au tap (ex. '/post/<id>'). Optionnel.
  linkPath String?                 @map("link_path") @db.VarChar(200)

  totalRecipients Int @default(0) @map("total_recipients")
  sentCount       Int @default(0) @map("sent_count")
  failedCount     Int @default(0) @map("failed_count")

  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation("OfficialBroadcastAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz

  @@index([createdAt])
  @@map("official_broadcasts")
}

// ── Réglages runtime ─────────────────────────────────────────────
// Réutilisable pour tout futur feature-flag.
model AppSetting {
  key         String   @id @db.VarChar(60) // 'registration_mode', 'default_invite_quota', 'invite_expiry_days'
  value       String   @db.VarChar(100)
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}

// ── Animation éditoriale ─────────────────────────────────────────
// L'atelier (Claude Code, sur le poste du propriétaire) REMPLIT cette file ;
// le cron du serveur la VIDE à l'heure prévue. Les deux moitiés sont séparées
// pour que l'extinction du poste n'arrête pas la plateforme : le contenu est
// produit par lots quand la machine est allumée, distribué 24/7 sans elle.

enum AnimationKind {
  /// Ce qui change dans la loi et impacte les Nigériens du pays. VALIDATION
  /// HUMAINE OBLIGATOIRE + source citée : une erreur ici coûte un titre de
  /// séjour ou un permis à quelqu'un.
  law
  /// Bon plan, vie moins chère, démarche gratuite. Publié sans validation.
  tip
  /// Ambiance, question, entraide. Publié sans validation.
  chat
}

enum AnimationStatus {
  /// Rédigé, en attente de validation humaine (le défaut pour `law`).
  draft
  /// Bon pour publication — le cron le prendra à `scheduledAt`.
  approved
  /// Publié : `publishedPostId` porte le post réel.
  published
  /// Refusé en relecture. Conservé, jamais republié.
  rejected
}

model AnimationPost {
  id              String          @id @default(uuid()) @db.Uuid
  /// Le compte d'animation qui signera la publication (User.isAnimated).
  botId           String          @map("bot_id") @db.Uuid
  bot             User            @relation("AnimationAuthor", fields: [botId], references: [id], onDelete: Cascade)
  /// Pays visé, dénormalisé depuis le bot : sert au planning et au suivi sans
  /// jointure, et garde la trace même si le bot change de ville plus tard.
  countryCode     String?         @map("country_code") @db.Char(2)
  kind            AnimationKind
  status          AnimationStatus @default(draft)
  content         String          @db.Text
  /// Image générée, déjà bindée au bucket public via S3Service.
  mediaUrl        String?         @map("media_url") @db.VarChar(500)
  /// Source officielle. EXIGÉE pour `law` — voir AnimationService.
  sourceUrl       String?         @map("source_url") @db.VarChar(500)
  scheduledAt     DateTime        @map("scheduled_at") @db.Timestamptz
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz
  /// Post réellement créé, une fois la file vidée. Null tant que non publié.
  publishedPostId String?         @map("published_post_id") @db.Uuid
  /// Motif de refus, pour que l'atelier ne repropose pas la même chose.
  reviewNote      String?         @map("review_note") @db.VarChar(500)
  reviewedById    String?         @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?           @relation("AnimationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  /// Le cron ne lit que (status, scheduledAt) : index composite dédié.
  @@index([status, scheduledAt])
  @@index([botId, scheduledAt])
  @@map("animation_posts")
}

/// Réglages d'un compte d'animation, pilotables depuis la console SANS déploiement.
/// Séparé de User exprès : ce sont des paramètres d'exploitation, pas un profil,
/// et rien ici ne doit pouvoir remonter dans une sélection publique par accident.
model AnimationBot {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @unique @map("user_id") @db.Uuid
  user   User          @relation("AnimationBotAccount", fields: [userId], references: [id], onDelete: Cascade)
  /// nc01…nc25 — stable, sert de clé de reprise pour l'atelier.
  handle String        @unique @db.VarChar(8)
  kind   AnimationKind
  /// Interrupteur par compte : une extinction immédiate sans toucher au code.
  active Boolean       @default(true)

  // ── Cadence ────────────────────────────────────────────────
  postsPerWeek    Int @default(2) @map("posts_per_week")
  commentsPerDay  Int @default(3) @map("comments_per_day")
  likesPerDay     Int @default(8) @map("likes_per_day")
  friendReqPerDay Int @default(2) @map("friend_req_per_day")
  /// Fenêtre d'activité en heure LOCALE du bot. Personne ne commente à 4 h.
  activeFromHour  Int @default(8) @map("active_from_hour")
  activeToHour    Int @default(22) @map("active_to_hour")

  /// Thèmes que l'atelier doit couvrir pour ce compte.
  topics    String[] @default([])
  notes     String?  @db.VarChar(1000)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  replies AnimationReply[]
  actions AnimationAction[]

  @@index([active])
  @@map("animation_bots")
}

enum AnimationReplyStatus {
  /// En attente de son heure (voir `dueAt` — délai qui double à chaque tour).
  pending
  sent
  /// Remontée à la console : le bot ne répond plus dans cette conversation.
  escalated
  /// Abandonnée (conversation trop ancienne, bot désactivé).
  skipped
}

/// Réponse différée d'un compte d'animation à un message reçu.
///
/// Le délai double à chaque échange (5, 10, 20, 40 min…) mais est PLAFONNÉ :
/// non borné, la sixième réponse arriverait le lendemain et la conversation
/// mourrait — le mécanisme censé faire humain rendrait le compte muet.
///
/// `escalated` est le repli assumé : dès qu'un membre demande à qui il parle,
/// le compte se tait et la conversation atterrit dans la console. On ne
/// construit pas d'esquive.
model AnimationReply {
  id                String               @id @default(uuid()) @db.Uuid
  botId             String               @map("bot_id") @db.Uuid
  bot               AnimationBot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId    String               @map("conversation_id") @db.Uuid
  /// Message entrant auquel on répond — unique, pour ne jamais répondre deux fois.
  incomingMessageId String               @unique @map("incoming_message_id") @db.Uuid
  status            AnimationReplyStatus @default(pending)
  /// Rang de l'échange, base du doublement du délai.
  attempt           Int                  @default(0)
  dueAt             DateTime             @map("due_at") @db.Timestamptz
  /// Texte rédigé par l'atelier. Null tant qu'il n'est pas passé.
  draft             String?              @db.Text
  sentMessageId     String?              @map("sent_message_id") @db.Uuid
  escalationReason  String?              @map("escalation_reason") @db.VarChar(200)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, dueAt])
  @@index([conversationId])
  @@map("animation_replies")
}

enum AnimationActionType {
  like
  comment
  friend_request
}

enum AnimationActionStatus {
  /// Programmée, pas encore l'heure. Un `comment` attend aussi son texte.
  pending
  done
  /// Écartée : cible disparue, quota atteint, compte éteint, règle diaspora.
  skipped
}

/// Geste d'engagement programmé d'un compte d'animation.
///
/// Le serveur CHOISIT la cible et l'heure ; l'atelier n'écrit que le texte des
/// commentaires. Un like et une demande d'ami n'ont pas de contenu, ils partent
/// donc seuls — mais toujours à une heure décidée à l'avance et étalée, jamais
/// en rafale au moment du balayage.
model AnimationAction {
  id           String                @id @default(uuid()) @db.Uuid
  botId        String                @map("bot_id") @db.Uuid
  bot          AnimationBot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  type         AnimationActionType
  status       AnimationActionStatus @default(pending)
  /// Cible : un post (like, comment) ou un membre (friend_request).
  targetPostId String?               @map("target_post_id") @db.Uuid
  targetUserId String?               @map("target_user_id") @db.Uuid
  /// Texte du commentaire, écrit par l'atelier. Null pour like / demande d'ami.
  draft        String?               @db.Text
  dueAt        DateTime              @map("due_at") @db.Timestamptz
  doneAt       DateTime?             @map("done_at") @db.Timestamptz
  skipReason   String?               @map("skip_reason") @db.VarChar(200)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  /// Un compte ne like pas deux fois le même post, ni ne redemande en ami
  /// quelqu'un qu'il a déjà sollicité. Garanti en base, pas seulement en code.
  @@unique([botId, type, targetPostId])
  @@unique([botId, type, targetUserId])
  @@index([status, dueAt])
  @@map("animation_actions")
}
