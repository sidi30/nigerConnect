// NigerConnect — Schéma Prisma
// Phases 1-2 : User complet, identity_documents, refresh_tokens, push_tokens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  moderator
  admin
}

enum UserStatus {
  active
  suspended
  banned
}

enum IdentityStatus {
  not_submitted
  pending
  approved
  rejected
}

enum PrivacyLevel {
  public
  friends
  private
}

enum OAuthProvider {
  google
  facebook
  apple
}

enum DocumentStatus {
  pending
  approved
  rejected
}

enum Platform {
  ios
  android
  web
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String?        @unique @db.VarChar(255)
  phone           String?        @unique @db.VarChar(20)
  passwordHash    String?        @map("password_hash") @db.VarChar(255)
  oauthProvider   OAuthProvider? @map("oauth_provider")
  oauthProviderId String?        @map("oauth_provider_id") @db.VarChar(255)

  firstName   String? @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(100)
  bio         String? @db.Text
  avatarUrl   String? @map("avatar_url") @db.VarChar(500)
  coverUrl    String? @map("cover_url") @db.VarChar(500)

  city             String?   @db.VarChar(100)
  countryCode      String?   @map("country_code") @db.Char(2)
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  // Map visibility is OFF by default (safety-by-default, RGPD art.25): a member
  // only appears on the public map after an explicit opt-in. Mirrors
  // proximityAlerts, which is likewise opt-in.
  showOnMap        Boolean   @default(true) @map("show_on_map")
  // Opt-OUT depuis le 24/08/2026 (décision du propriétaire). En opt-in, 3
  // comptes sur 305 l'avaient activé : la fonctionnalité ne pouvait pas
  // exister faute de deux personnes actives au même endroit. Ce drapeau seul
  // n'expose rien — aucune position n'est lue tant que l'utilisateur n'a pas
  // accordé la localisation au niveau du système ET ouvert l'app à l'écran, et
  // rien d'identifiant ne sort d'un croisement (cf. assertCanReveal).
  proximityAlerts  Boolean   @default(true) @map("proximity_alerts")
  // Receive NigerConnect news/announcements (in-app + push + email). Opt-OUT:
  // ON by default; the user toggles it in settings. Critical service messages
  // (security/outage/RGPD) ignore this flag. newsletterToken backs the one-click
  // email unsubscribe that flips this off.
  newsletterOptIn  Boolean   @default(true) @map("newsletter_opt_in")
  newsletterToken  String?   @unique @map("newsletter_token") @db.VarChar(64)
  proximityRadius  Int       @default(100) @map("proximity_radius")
  // Weekly regional digest (E-DIGEST). Opt-OUT: ON by default; the member toggles
  // it in Privacy settings. lastDigestSentAt stamps the last successful send and
  // enforces at-most-once per 7-day sliding window (idempotent cron, no double push
  // on restart/relaunch — the stamp is written BEFORE the push is fired).
  digestOptIn      Boolean   @default(true) @map("digest_opt_in")
  lastDigestSentAt DateTime? @map("last_digest_sent_at") @db.Timestamptz

  // Quelles notifications font vibrer le téléphone. Opt-OUT : TOUT est ON à
  // l'inscription — un réseau social muet par défaut ne ramène personne — et
  // le membre coupe ce qu'il veut dans Réglages ▸ Notifications. Ne filtre que
  // le PUSH : l'historique in-app continue de tout enregistrer, sinon couper
  // une catégorie ferait disparaître des demandes d'ami en attente.
  // Les notifications de service (identité vérifiée/refusée, `system`) ne sont
  // pas réglables : elles répondent à une action du membre ou l'avertissent
  // d'une décision le concernant.
  notifyMessages  Boolean @default(true) @map("notify_messages")
  notifySocial    Boolean @default(true) @map("notify_social")
  notifyReactions Boolean @default(true) @map("notify_reactions")
  notifyGroups    Boolean @default(true) @map("notify_groups")
  notifyProximity Boolean @default(true) @map("notify_proximity")

  // One-shot "complète ton profil" email nudge for verified accounts still
  // missing a countryCode (OAuth signups skip the registration form). Stamped
  // BEFORE the send (at-most-once, mirrors lastDigestSentAt) — null means
  // "never reminded". Written exactly once per account, never reset.
  profileReminderSentAt DateTime? @map("profile_reminder_sent_at") @db.Timestamptz

  // Ephemeral, PRIVATE proximity-matching position. Written by the foreground
  // proximity ping and used ONLY by the Haversine matcher (filtered by
  // proximityUpdatedAt freshness). NEVER selected by the public map surfaces
  // (markers / nearby / clusters) so live GPS never leaks through the
  // city-coarse latitude/longitude pin.
  proximityLat       Decimal?  @map("proximity_lat") @db.Decimal(10, 7)
  proximityLon       Decimal?  @map("proximity_lon") @db.Decimal(10, 7)
  proximityUpdatedAt DateTime? @map("proximity_updated_at") @db.Timestamptz

  languages    String[]     @default(["fr"])
  privacyLevel PrivacyLevel @default(public) @map("privacy_level")

  emailVerified   Boolean        @default(false) @map("email_verified")
  phoneVerified   Boolean        @default(false) @map("phone_verified")
  identityStatus  IdentityStatus @default(not_submitted) @map("identity_status")
  // Ambassador badge: a curated, admin-managed distinction (community leaders /
  // official ambassadors) shown ALONGSIDE the identity-verified badge — they are
  // independent (a user can be identity-verified, an ambassador, both, or neither).
  // Toggled only from the tenant admin console; never self-assigned.
  isAmbassador    Boolean        @default(false) @map("is_ambassador")
  // Instant de nomination, pose par la console admin en meme temps que le badge
  // et efface quand on le retire. Sans lui, la console peut lister QUI est
  // ambassadeur mais jamais depuis quand — l'info que reclame la relecture d'un
  // reseau de referents.
  ambassadorSince DateTime?      @map("ambassador_since") @db.Timestamptz
  // Compte OFFICIEL NigerConnect : la voix de l'application elle-meme. Ce n'est
  // PAS un membre — il est retire de toutes les surfaces de decouverte (
  // recherche, suggestions, carte, proximite, demandes d'ami) et personne ne
  // peut ouvrir une conversation avec lui ; en echange il parle a tout le monde
  // (notification, message direct, story, publication publique). Pose
  // uniquement depuis la console admin, jamais auto-attribue : c'est ce qui
  // permet a son badge de valoir garantie.
  isOfficial      Boolean        @default(false) @map("is_official")
  officialSince   DateTime?      @map("official_since") @db.Timestamptz
  // Compte d'animation editoriale, pilote par l'atelier (voir AnimationPost).
  // Marqueur STRICTEMENT INTERNE : absent de USER_PUBLIC_SELECT et de
  // USER_SELF_SELECT, il ne sort jamais de l'API. Il sert a trois choses et
  // trois seulement : retirer ces comptes de la carte et de la proximite (elles
  // supposent une presence physique verifiable), accepter automatiquement les
  // demandes d'ami, et router leurs messages recus vers la console au lieu de
  // les laisser sans reponse.
  isAnimated      Boolean        @default(false) @map("is_animated")
  role            UserRole       @default(user)
  status          UserStatus     @default(active)
  // Sanction metadata (set alongside status by the admin console). statusReason
  // is the human-readable motive shown back to the sanctioned user; statusExpiresAt
  // is the optional auto-lift instant for a temporary suspension (null = permanent /
  // until manually lifted). Both are cleared when the status returns to `active`.
  statusReason    String?        @map("status_reason") @db.VarChar(500)
  statusExpiresAt DateTime?      @map("status_expires_at") @db.Timestamptz

  // Aggregate of reviews received on this profile (Feature: avis).
  // Maintained transactionally by ReviewService — never written elsewhere.
  ratingAvg   Float @default(0) @map("rating_avg")
  ratingCount Int   @default(0) @map("rating_count")

  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") @db.VarChar(255)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp      String?   @map("last_login_ip") @db.Inet
  // Last authenticated request, stamped at most hourly by LastSeenInterceptor.
  // Distinct from lastLoginAt (a new session) — this is what makes active-member
  // counts and retention computable at all. Written raw so @updatedAt stays put.
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  identityDocuments       IdentityDocument[]     @relation("UserIdentityDocuments")
  reviewedDocuments       IdentityDocument[]     @relation("DocumentReviewer")
  refreshTokens           RefreshToken[]
  pushTokens              PushToken[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  emailTokens             EmailToken[]
  photos                  UserPhoto[]
  friendshipsSent         Friendship[]           @relation("FriendshipRequester")
  friendshipsReceived     Friendship[]           @relation("FriendshipAddressee")
  proximityEncountersA    ProximityEncounter[]   @relation("EncounterUserA")
  proximityEncountersB    ProximityEncounter[]   @relation("EncounterUserB")
  proximityEncountersReq  ProximityEncounter[]   @relation("EncounterRequester")
  messageReactions        MessageReaction[]
  blocksMade              Block[]                @relation("BlockBlocker")
  blocksReceived          Block[]                @relation("BlockBlocked")
  posts                   Post[]
  likes                   Like[]
  commentLikes            CommentLike[]
  comments                Comment[]
  conversationMemberships ConversationMember[]
  conversationsCreated    Conversation[]         @relation("ConversationCreator")
  messages                Message[]
  serviceRequests         ServiceRequest[]
  serviceResponses        ServiceResponse[]
  associationsCreated     Association[]          @relation("AssociationCreator")
  associationMemberships  AssociationMember[]
  associationsVerified    Association[]          @relation("AssociationVerifier")
  associationOwnerInvites Association[]          @relation("AssociationPendingOwner")
  associationRoleAuditsBy AssociationRoleAudit[] @relation("AssociationRoleAuditActor")
  associationRoleAuditsOn AssociationRoleAudit[] @relation("AssociationRoleAuditTarget")
  associationOfficerSeats AssociationOfficer[]
  notifications           Notification[]         @relation("NotificationRecipient")
  notificationsActedOn    Notification[]         @relation("NotificationActor")
  reportsMade             Report[]               @relation("ReportReporter")
  reportsReviewed         Report[]               @relation("ReportReviewer")
  pagesCreated            Page[]                 @relation("PageCreator")
  pageFollows             PageFollower[]
  pageAdminOf             PageAdmin[]
  pollsCreated            Poll[]
  pollVotes               PollVote[]
  reviewsAuthored         Review[]               @relation("ReviewAuthor")
  reviewsReceived         Review[]               @relation("ReviewTargetUser")
  communityPrices         CommunityPrice[]
  communityPriceVotes     CommunityPriceVote[]

  // ── Parrainage ──────────────────────────────────────────────────
  // Parrain direct (arbre). SetNull si le parrain supprime son compte —
  // on ne casse pas le filleul, on perd juste le lien de parenté.
  invitedById      String?     @map("invited_by_id") @db.Uuid
  invitedBy        User?       @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees         User[]      @relation("UserInvitedBy")
  // Droit accordé par l'admin de créer des liens d'invitation RÉUTILISABLES
  // (1 lien → N inscriptions, partage en masse). L'invitation email/code
  // single-use reste ouverte à tous les inscrits vérifiés.
  canBulkInvite    Boolean     @default(false) @map("can_bulk_invite")
  // Par quelle invitation ce compte s'est inscrit (analytics réseau : permet de
  // compter les inscriptions par lien réutilisable). Distinct de invitedById
  // (l'arbre de parenté). SetNull si l'invitation est supprimée.
  invitedViaId     String?     @map("invited_via_id") @db.Uuid
  invitedVia       Invitation? @relation("InvitationSignups", fields: [invitedViaId], references: [id], onDelete: SetNull)
  // DÉPRÉCIÉ (v2 réseau) : plus de quota dur ni d'expiration. Colonnes conservées
  // pour éviter une migration destructive ; plus lues ni posées par le code.
  inviteQuota      Int         @default(3) @map("invite_quota")
  // Compteur d'abus : +1 quand un filleul est banni. ≥ 3 → création d'invitation gelée.
  inviteAbuseFlags Int         @default(0) @map("invite_abuse_flags")

  invitesSent     Invitation[] @relation("UserInvitesSent")
  invitesAccepted Invitation[] @relation("UserInviteAccepted")

  contactMessages ContactMessage[] @relation("UserContactMessages")

  officialBroadcasts OfficialBroadcast[] @relation("OfficialBroadcastAuthor")
  animationPosts     AnimationPost[]     @relation("AnimationAuthor")
  animationReviews   AnimationPost[]     @relation("AnimationReviewer")
  animationBot       AnimationBot?       @relation("AnimationBotAccount")

  // Unique per OAuth identity so concurrent link-or-create requests can't mint
  // duplicate accounts (the DB is the final arbiter — see loginWithOAuth).
  // Both columns are nullable; Postgres treats NULLs as distinct, so the many
  // password-only users (provider + id both NULL) are unaffected.
  @@unique([oauthProvider, oauthProviderId])
  @@index([countryCode, city])
  @@index([latitude, longitude])
  @@index([showOnMap, status])
  @@index([invitedById])
  @@index([invitedViaId])
  // Powers the E-DIGEST batch selection (opt-in + due members), keeping the
  // hourly cron scan cheap even as the member table grows.
  @@index([digestOptIn, lastDigestSentAt])
  // Un seul compte officiel en pratique : l'index sert a le retrouver sans
  // balayer la table a chaque action de la console.
  @@index([isOfficial])
  @@index([isAnimated])
  @@map("users")
}

enum FriendshipStatus {
  pending
  accepted
  declined
}

enum ProximityEncounterStatus {
  active
  requested
  accepted
  declined
  expired
}

enum PostVisibility {
  public
  friends
  association
}

enum MediaType {
  image
  video
}

enum ConversationType {
  direct
  group
}

enum MessageType {
  text
  image
  file
  system
}

enum ConversationRole {
  admin
  member
}

enum ServiceCategory {
  logement
  transport
  admin_category
  sante
  emploi
  business
  education
  autre
}

enum ServiceUrgency {
  urgent
  normal
}

enum ServiceStatus {
  open
  in_progress
  resolved
  closed
}

enum ServiceIntent {
  help_free
  paid_service
}

enum AssociationCategory {
  generaliste
  etudiants
  femmes
  jeunesse
  culture
  business
  sport
  religieux
}

enum AssociationRole {
  admin
  moderator
  member
  // Founder / current title-holder — the one role an `admin` may never touch
  // (A3). Exactly 0 or 1 per association: set at creation (create()) and only
  // ever moved by the accept-side of an ownership transfer, never by a plain
  // role-change PATCH. Added after `member` in the enum text for readability;
  // the DB value was appended via a standalone `ALTER TYPE ... ADD VALUE`
  // migration (2-step — see migration notes) so it could be used by the very
  // next migration's backfill without hitting Postgres's same-transaction ban.
  owner
}

enum MembershipStatus {
  pending
  approved
  rejected
}

enum PageKind {
  community
  cause
  business
  official
  group
}

enum PageRole {
  admin
  editor
}

enum ReviewTargetType {
  user
  page
}

enum NotificationType {
  friend_request
  friend_accepted
  like
  comment
  message
  service_response
  association_invite
  association_join_request
  association_join_approved
  association_join_rejected
  identity_approved
  identity_rejected
  proximity
  page_follow
  poll_new
  review_received
  system
  invite_accepted
  mention
  announcement
  // Weekly regional retention digest (E-DIGEST). Aggregate-only push
  // (counts of events / help requests / new PUBLIC members near the member);
  // never carries a third-party name/id. Sent at most once per 7-day window.
  weekly_digest
  // A2/A3 — association governance (see association.service.ts).
  association_role_changed
  association_ownership_transfer
  association_officer_invite
}

// ── Parrainage ────────────────────────────────────────────────────

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum InvitationKind {
  // Email/code à usage unique : une seule acceptation (pending → accepted).
  single_use
  // Lien partageable réutilisable : N inscriptions, jamais consommé
  // (status reste pending = actif). Réservé aux users canBulkInvite.
  reusable
}

enum ContactTopic {
  partnership
  info
  problem
  other
}

enum ContactStatus {
  // Jamais ouvert dans la console.
  new
  // Lu, en attente de réponse.
  read
  // Traité : sort de la liste par défaut.
  handled
}

enum ReportTargetType {
  user
  post
  message
  association
  comment
  community_price
}

enum ReportReason {
  spam
  harassment
  inappropriate
  fake_identity
  scam
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum ReportAction {
  warning
  content_removed
  suspended
  banned
  none
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @map("addressee_id") @db.Uuid
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

/// Mutual, double-blind proximity encounter. Created when two opted-in, eligible
/// users cross paths; ANONYMOUS to both until one `connect`s (requester revealed)
/// and the other `accept`s (mutual reveal + Friendship). Participants stored
/// sorted (userAId < userBId) so the @@unique dedupes the unordered pair.
model ProximityEncounter {
  id             String                   @id @default(uuid()) @db.Uuid
  userAId        String                   @map("user_a_id") @db.Uuid
  userA          User                     @relation("EncounterUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId        String                   @map("user_b_id") @db.Uuid
  userB          User                     @relation("EncounterUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status         ProximityEncounterStatus @default(active)
  requesterId    String?                  @map("requester_id") @db.Uuid
  requester      User?                    @relation("EncounterRequester", fields: [requesterId], references: [id])
  // Coarse distance bucket FROZEN at first crossing — never recomputed, so a
  // participant can't triangulate the other by moving and re-pinging.
  distanceBucket Int                      @map("distance_bucket")
  zone           String                   @db.VarChar(20)
  // Optimistic-lock version for the connect/accept collision (PX4).
  version        Int                      @default(0)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  respondedAt    DateTime?                @map("responded_at") @db.Timestamptz
  expiresAt      DateTime?                @map("expires_at") @db.Timestamptz

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([requesterId])
  @@map("proximity_encounters")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id") @db.Uuid
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum EmailTokenType {
  reset_password
  verify_email
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash") @db.VarChar(255)
  // sha256 of the 6-digit verification code (null for link-only tokens).
  codeHash  String?        @map("code_hash") @db.VarChar(255)
  // Wrong-code guess counter — caps brute-force on the low-entropy code.
  attempts  Int            @default(0)
  expiresAt DateTime       @map("expires_at") @db.Timestamptz
  usedAt    DateTime?      @map("used_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, type])
  @@map("email_tokens")
}

model Post {
  id             String         @id @default(uuid()) @db.Uuid
  authorId       String         @map("author_id") @db.Uuid
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String?        @db.Text
  visibility     PostVisibility @default(friends)
  associationId  String?        @map("association_id") @db.Uuid
  isStory        Boolean        @default(false) @map("is_story")
  storyExpiresAt DateTime?      @map("story_expires_at") @db.Timestamptz
  sharedPostId   String?        @map("shared_post_id") @db.Uuid
  sharedPost     Post?          @relation("PostShares", fields: [sharedPostId], references: [id])
  shares         Post[]         @relation("PostShares")
  likeCount      Int            @default(0) @map("like_count")
  commentCount   Int            @default(0) @map("comment_count")
  shareCount     Int            @default(0) @map("share_count")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  media    PostMedia[]
  likes    Like[]
  comments Comment[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([associationId, createdAt(sort: Desc)])
  @@index([isStory, storyExpiresAt])
  @@map("posts")
}

model PostMedia {
  id           String    @id @default(uuid()) @db.Uuid
  postId       String    @map("post_id") @db.Uuid
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaUrl     String    @map("media_url") @db.VarChar(500)
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(500)
  mediaType    MediaType @map("media_type")
  width        Int?
  height       Int?
  blurhash     String?   @db.VarChar(100)
  sortOrder    Int       @default(0) @map("sort_order")

  @@index([postId])
  @@map("post_media")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  // The reaction emoji (Instagram/Facebook-style). Legacy likes default to ❤️.
  emoji     String   @default("❤️") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String        @map("author_id") @db.Uuid
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?       @map("parent_id") @db.Uuid
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("CommentReplies")
  content   String        @db.Text
  likeCount Int           @default(0) @map("like_count")
  likes     CommentLike[]
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([postId, createdAt])
